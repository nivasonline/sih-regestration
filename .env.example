# ─── SERVER SETTINGS ─────────────────────────────────
PORT=3000

# ─── ADMIN DASHBOARD ─────────────────────────────────
# Password to access the /admin dashboard
ADMIN_PASSWORD=your_secure_password_here

# ─── EMAIL (Gmail SMTP) ──────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in below and set EMAIL_ENABLED=true
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# ─── GOOGLE SHEETS ───────────────────────────────────
# Paste your Apps Script Web App URL here
# Example: https://script.google.com/macros/s/.../exec
GOOGLE_SHEETS_URL=your_google_sheets_apps_script_url_here

# ─── RAZORPAY ────────────────────────────────────────
# Get these from your Razorpay Dashboard (Test or Live mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
